<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CityExplorer.ViewModels"
             xmlns:models="clr-namespace:CityExplorer.Models"
             xmlns:strings="clr-namespace:CityExplorer.Resources.Localization"
             x:Class="CityExplorer.Views.ExplorePage"
             x:DataType="vm:ExploreViewModel"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <Grid RowDefinitions="Auto,*" Padding="0,0,0,8">

        <!-- Päis -->
        <StackLayout Grid.Row="0" BackgroundColor="#1A1A2E" Padding="16,48,16,16">
            <Label Text="{x:Static strings:AppResources.ExploreTitle}"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White" />
            <Label Text="🇪🇪 Tallinn"
                   FontSize="14"
                   TextColor="#AAAAAA" />
        </StackLayout>

        <!-- Sisu: Karussell + Emotikonide menüü -->
        <Grid Grid.Row="1" ColumnDefinitions="*,64" Margin="0,8,0,0">

            <!-- Karussell + indikaator -->
            <StackLayout Grid.Column="0">
                <CarouselView x:Name="MainCarousel"
                              ItemsSource="{Binding Places}"
                              IndicatorView="carouselIndicator"
                              Loop="True"
                              HeightRequest="400"
                              PeekAreaInsets="16">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="models:Place">
                            <Frame Margin="8,4"
                                   CornerRadius="20"
                                   HasShadow="True"
                                   Padding="0"
                                   
                                   BorderColor="Transparent">
                                <Grid RowDefinitions="220,*">

                                    <!-- Pilt -->
                                    <Image Grid.Row="0"
                                           Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           HeightRequest="220" />

                                    <!-- Kategooria märgend pildil -->
                                    <Frame Grid.Row="0"
                                           BackgroundColor="#CC000000"
                                           CornerRadius="12"
                                           Padding="6,3"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start"
                                           Margin="10"
                                           HasShadow="False">
                                        <Label Text="{Binding CategoryEmoji}" FontSize="18" />
                                    </Frame>

                                    <!-- Info ala -->
                                    <StackLayout Grid.Row="1" Padding="16,12,16,8" Spacing="4">
                                        <Label Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1A1A2E, Dark=White}" />
                                        <Label Text="{Binding Description}"
                                               FontSize="13"
                                               TextColor="Gray"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                        <Button Text="{x:Static strings:AppResources.AddToFavorites}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=AddToFavoritesCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#E63946"
                                                TextColor="White"
                                                CornerRadius="10"
                                                FontSize="13"
                                                HeightRequest="40"
                                                Margin="0,6,0,0" />
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <!-- IndicatorView -->
                <IndicatorView x:Name="carouselIndicator"
                               IndicatorColor="#CCCCCC"
                               SelectedIndicatorColor="#E63946"
                               IndicatorSize="8"
                               HorizontalOptions="Center"
                               Margin="0,6,0,0" />
            </StackLayout>

            <!-- Emotikonide kategooriafilter (paremal) -->
            <ScrollView Grid.Column="1" Orientation="Vertical" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="4,8" Spacing="6">
                    <CollectionView ItemsSource="{Binding Categories}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <Frame CornerRadius="14"
                                       Padding="0"
                                       HasShadow="False"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                       WidthRequest="52"
                                       HeightRequest="52">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExploreViewModel}}, Path=FilterCommand}"
                                            CommandParameter="{Binding Emoji}" />
                                    </Frame.GestureRecognizers>
                                    <Label Text="{Binding Emoji}"
                                           FontSize="26"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </Grid>
</ContentPage>

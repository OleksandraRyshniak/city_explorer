<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CityExplorer.ViewModels"
             xmlns:models="clr-namespace:CityExplorer.Models"
             xmlns:strings="clr-namespace:CityExplorer.Resources.Localization"
             x:Class="CityExplorer.Views.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- Päis -->
        <StackLayout Grid.Row="0" BackgroundColor="#1A1A2E" Padding="16,48,16,16">
            <Label Text="{x:Static strings:AppResources.FavoritesTitle}"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White" />
        </StackLayout>

        <!-- Lemmikute nimekiri -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Favorites}"
                        Margin="8,8">

            <!-- Tühja nimekirja vaade -->
            <CollectionView.EmptyView>
                <StackLayout HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12"
                             Padding="32">
                    <Label Text="❤️"
                           FontSize="56"
                           HorizontalOptions="Center" />
                    <Label Text="{x:Static strings:AppResources.NoFavorites}"
                           FontSize="16"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                </StackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Place">
                    <Frame Margin="4,4"
                           CornerRadius="14"
                           HasShadow="True"
                           Padding="0"
                          
                           BorderColor="Transparent">
                        <Grid ColumnDefinitions="100,*,56" HeightRequest="96">

                            <!-- Pisipilt -->
                            <Image Grid.Column="0"
                                   Source="{Binding ImageUrl}"
                                   Aspect="AspectFill"
                                   WidthRequest="100" />

                            <!-- Info -->
                            <StackLayout Grid.Column="1"
                                         Padding="12,10"
                                         VerticalOptions="Center"
                                         Spacing="4">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light=#1A1A2E, Dark=White}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding CategoryEmoji}"
                                       FontSize="20" />
                                <Label Text="{Binding Description}"
                                       FontSize="11"
                                       TextColor="Gray"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                            </StackLayout>

                            <!-- Kustuta nupp -->
                            <Button Grid.Column="2"
                                    Text="🗑️"
                                    FontSize="20"
                                    BackgroundColor="Transparent"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=RemoveCommand}"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

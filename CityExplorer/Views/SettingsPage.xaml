<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CityExplorer.ViewModels"
             xmlns:strings="clr-namespace:CityExplorer.Resources.Localization"
             x:Class="CityExplorer.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <!-- Päis -->
        <StackLayout Grid.Row="0" BackgroundColor="#1A1A2E" Padding="16,48,16,16">
            <Label Text="{x:Static strings:AppResources.SettingsTitle}"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White" />
        </StackLayout>

        <!-- Seadete sisu -->
        <StackLayout Grid.Row="1" Padding="24,24" Spacing="16">

            <Label Text="{x:Static strings:AppResources.SelectLanguage}"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1A1A2E, Dark=White}"
                   Margin="0,0,0,8" />

            <!-- Eesti keel -->
            <Frame CornerRadius="16" Padding="0" HasShadow="True" BorderColor="Transparent">
                <Button Text="🇪🇪  Eesti keel"
                        Command="{Binding ChangeLanguageCommand}"
                        CommandParameter="et"
                        BackgroundColor="#0072CE"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="58" />
            </Frame>

            <!-- Inglise keel -->
            <Frame CornerRadius="16" Padding="0" HasShadow="True" BorderColor="Transparent">
                <Button Text="🇬🇧  English"
                        Command="{Binding ChangeLanguageCommand}"
                        CommandParameter="en"
                        BackgroundColor="#0072CE"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="58" />
            </Frame>

            <!-- Vene keel -->
            <Frame CornerRadius="16" Padding="0" HasShadow="True" BorderColor="Transparent">
                <Button Text="🇷🇺  Русский язык"
                        Command="{Binding ChangeLanguageCommand}"
                        CommandParameter="ru"
                        BackgroundColor="#0072CE"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        HeightRequest="58" />
            </Frame>

            <!-- Praegune keel -->
            <StackLayout Margin="0,16,0,0" Orientation="Horizontal" Spacing="8">
                <Label Text="Aktiivne keel:"
                       FontSize="14"
                       TextColor="Gray"
                       VerticalOptions="Center" />
                <Label Text="{Binding CurrentLanguage}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#E63946"
                       VerticalOptions="Center" />
            </StackLayout>

        </StackLayout>
    </Grid>
</ContentPage>
